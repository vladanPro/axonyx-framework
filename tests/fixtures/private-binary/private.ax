route GET "/api/private/:id" -> Binary {
  return Native.privateResponse("media.read", { id: params.id })
}

route GET "/api/private-unknown" -> Binary {
  return Native.privateResponse("media.unregistered", {})
}

route GET "/api/public/:id" -> Binary {
  return Native.publicResponse("media.public", { id: params.id })
}

route GET "/api/public-private-channel" -> Binary {
  return Native.publicResponse("media.read", { id: "image" })
}

route GET "/api/public-unknown" -> Binary {
  return Native.publicResponse("media.unregistered", {})
}

route POST "/api/fixture-unpublish" {
  require Auth.subject != "" else forbidden()
  data result = Native.call("fixture.unpublish", {})
  return json(result)
}

route POST "/api/fixture-login" {
  require query.key == "isolated-fixture-only" else forbidden()
  Session.create("fixture-owner", {})
  return json({ ok: true })
}

route POST "/api/fixture-logout" {
  Session.destroy()
  return json({ ok: true })
}

route GET "/api/guard/:id" {
  require Auth.subject != "" else forbidden()
  require params.id == "allowed" && request.method == "GET" else forbidden()
  require request.headers.x_fixture == "yes" else forbidden()
  require query.mode in ["preview", "compiled"] else forbidden()
  require query.public == "yes" || query.key == "isolated-fixture-only" else forbidden()
  return json({ subject: Auth.subject, mode: query.mode, literal: "query.key params.id Auth.subject" })
}
